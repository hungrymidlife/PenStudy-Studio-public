{
  "name": "penstudy-studio-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/android"
  ],
  "scripts": {
    "desktop": "npm run tauri --workspace=@penstudy/desktop -- dev",
    "desktop:build": "npm run tauri --workspace=@penstudy/desktop -- build",
    "android:web": "npm run dev -w @penstudy/android",
    "android:init": "npm run tauri --workspace=@penstudy/android -- android init",
    "android:dev": "npm run tauri --workspace=@penstudy/android -- android dev",
    "android:apk": "npm run tauri --workspace=@penstudy/android -- android build --apk --debug",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build --workspaces --if-present",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  }
}
