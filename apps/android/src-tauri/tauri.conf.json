{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenStudy Pad",
  "version": "0.1.0",
  "identifier": "com.penstudy.studio.pad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PenStudy Pad",
        "width": 430,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 28
    }
  }
}
